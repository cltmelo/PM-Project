<?xml version="1.0" ?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:typeLanguage="http://www.w3.org/2001/XMLSchema" xsi:expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://splitminer/process">
  <ns0:process id="SplitMinerProcess" isExecutable="false">
    <ns0:task id="task_W_Complete application" name="W_Complete application"/>
    <ns0:task id="task_W_Validate application" name="W_Validate application"/>
    <ns0:task id="task_O_Sent (mail and online)" name="O_Sent (mail and online)"/>
    <ns0:task id="task_A_Validating" name="A_Validating"/>
    <ns0:task id="task_A_Pending" name="A_Pending"/>
    <ns0:task id="task_A_Cancelled" name="A_Cancelled"/>
    <ns0:task id="task_A_Complete" name="A_Complete"/>
    <ns0:task id="task_O_Cancelled" name="O_Cancelled"/>
    <ns0:task id="task_W_Call incomplete files" name="W_Call incomplete files"/>
    <ns0:task id="task_A_Concept" name="A_Concept"/>
    <ns0:task id="task_A_Incomplete" name="A_Incomplete"/>
    <ns0:task id="task_O_Accepted" name="O_Accepted"/>
    <ns0:task id="task_A_Create Application" name="A_Create Application"/>
    <ns0:task id="task_A_Submitted" name="A_Submitted"/>
    <ns0:task id="task_W_Call after offers" name="W_Call after offers"/>
    <ns0:task id="task_O_Created" name="O_Created"/>
    <ns0:task id="task_A_Accepted" name="A_Accepted"/>
    <ns0:task id="task_O_Returned" name="O_Returned"/>
    <ns0:task id="task_O_Create Offer" name="O_Create Offer"/>
    <ns0:task id="task_W_Handle leads" name="W_Handle leads"/>
    <ns0:exclusiveGateway id="split_XOR_A_Concept" name="XOR Split after A_Concept" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_A_Create Application" name="XOR Split after A_Create Application" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_O_Cancelled" name="XOR Split after O_Cancelled" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_W_Call after offers" name="XOR Split after W_Call after offers" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_W_Call incomplete files" name="XOR Split after W_Call incomplete files" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_W_Complete application" name="XOR Split after W_Complete application" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_W_Handle leads" name="XOR Split after W_Handle leads" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="split_XOR_W_Validate application" name="XOR Split after W_Validate application" gatewayDirection="Diverging"/>
    <ns0:exclusiveGateway id="join_XOR_W_Call after offers" name="XOR Join before W_Call after offers" gatewayDirection="Converging"/>
    <ns0:exclusiveGateway id="join_XOR_A_Accepted" name="XOR Join before A_Accepted" gatewayDirection="Converging"/>
    <ns0:exclusiveGateway id="join_XOR_W_Complete application" name="XOR Join before W_Complete application" gatewayDirection="Converging"/>
    <ns0:exclusiveGateway id="join_XOR_W_Call incomplete files" name="XOR Join before W_Call incomplete files" gatewayDirection="Converging"/>
    <ns0:exclusiveGateway id="join_XOR_W_Validate application" name="XOR Join before W_Validate application" gatewayDirection="Converging"/>
    <ns0:exclusiveGateway id="join_XOR_W_Handle leads" name="XOR Join before W_Handle leads" gatewayDirection="Converging"/>
    <ns0:sequenceFlow id="flow_0" sourceRef="task_A_Accepted" targetRef="task_O_Create Offer" name="A_Accepted → O_Create Offer"/>
    <ns0:sequenceFlow id="flow_1" sourceRef="task_A_Cancelled" targetRef="task_O_Cancelled" name="A_Cancelled → O_Cancelled"/>
    <ns0:sequenceFlow id="flow_2" sourceRef="task_A_Complete" targetRef="task_W_Call after offers" name="A_Complete → W_Call after offers"/>
    <ns0:sequenceFlow id="flow_3" sourceRef="task_A_Concept" targetRef="task_A_Accepted" name="A_Concept → A_Accepted"/>
    <ns0:sequenceFlow id="flow_4" sourceRef="task_A_Concept" targetRef="task_W_Complete application" name="A_Concept → W_Complete application"/>
    <ns0:sequenceFlow id="flow_5" sourceRef="task_A_Create Application" targetRef="task_A_Submitted" name="A_Create Application → A_Submitted"/>
    <ns0:sequenceFlow id="flow_6" sourceRef="task_A_Create Application" targetRef="task_W_Complete application" name="A_Create Application → W_Complete application"/>
    <ns0:sequenceFlow id="flow_7" sourceRef="task_A_Incomplete" targetRef="task_W_Call incomplete files" name="A_Incomplete → W_Call incomplete files"/>
    <ns0:sequenceFlow id="flow_8" sourceRef="task_A_Pending" targetRef="task_W_Validate application" name="A_Pending → W_Validate application"/>
    <ns0:sequenceFlow id="flow_9" sourceRef="task_A_Submitted" targetRef="task_W_Handle leads" name="A_Submitted → W_Handle leads"/>
    <ns0:sequenceFlow id="flow_10" sourceRef="task_A_Validating" targetRef="task_O_Returned" name="A_Validating → O_Returned"/>
    <ns0:sequenceFlow id="flow_11" sourceRef="task_O_Accepted" targetRef="task_A_Pending" name="O_Accepted → A_Pending"/>
    <ns0:sequenceFlow id="flow_12" sourceRef="task_O_Cancelled" targetRef="task_W_Call after offers" name="O_Cancelled → W_Call after offers"/>
    <ns0:sequenceFlow id="flow_13" sourceRef="task_O_Create Offer" targetRef="task_O_Created" name="O_Create Offer → O_Created"/>
    <ns0:sequenceFlow id="flow_14" sourceRef="task_O_Created" targetRef="task_O_Sent (mail and online)" name="O_Created → O_Sent (mail and online)"/>
    <ns0:sequenceFlow id="flow_15" sourceRef="task_O_Returned" targetRef="task_W_Validate application" name="O_Returned → W_Validate application"/>
    <ns0:sequenceFlow id="flow_16" sourceRef="task_O_Sent (mail and online)" targetRef="task_W_Complete application" name="O_Sent (mail and online) → W_Complete application"/>
    <ns0:sequenceFlow id="flow_17" sourceRef="task_W_Call after offers" targetRef="task_A_Cancelled" name="W_Call after offers → A_Cancelled"/>
    <ns0:sequenceFlow id="flow_18" sourceRef="task_W_Call after offers" targetRef="task_A_Complete" name="W_Call after offers → A_Complete"/>
    <ns0:sequenceFlow id="flow_19" sourceRef="task_W_Call after offers" targetRef="task_W_Call after offers" name="W_Call after offers → W_Call after offers"/>
    <ns0:sequenceFlow id="flow_20" sourceRef="task_W_Call after offers" targetRef="task_W_Validate application" name="W_Call after offers → W_Validate application"/>
    <ns0:sequenceFlow id="flow_21" sourceRef="task_W_Call incomplete files" targetRef="task_A_Incomplete" name="W_Call incomplete files → A_Incomplete"/>
    <ns0:sequenceFlow id="flow_22" sourceRef="task_W_Call incomplete files" targetRef="task_W_Call incomplete files" name="W_Call incomplete files → W_Call incomplete files"/>
    <ns0:sequenceFlow id="flow_23" sourceRef="task_W_Complete application" targetRef="task_A_Accepted" name="W_Complete application → A_Accepted"/>
    <ns0:sequenceFlow id="flow_24" sourceRef="task_W_Complete application" targetRef="task_A_Concept" name="W_Complete application → A_Concept"/>
    <ns0:sequenceFlow id="flow_25" sourceRef="task_W_Complete application" targetRef="task_W_Call after offers" name="W_Complete application → W_Call after offers"/>
    <ns0:sequenceFlow id="flow_26" sourceRef="task_W_Complete application" targetRef="task_W_Complete application" name="W_Complete application → W_Complete application"/>
    <ns0:sequenceFlow id="flow_27" sourceRef="task_W_Handle leads" targetRef="task_W_Complete application" name="W_Handle leads → W_Complete application"/>
    <ns0:sequenceFlow id="flow_28" sourceRef="task_W_Handle leads" targetRef="task_W_Handle leads" name="W_Handle leads → W_Handle leads"/>
    <ns0:sequenceFlow id="flow_29" sourceRef="task_W_Validate application" targetRef="task_A_Validating" name="W_Validate application → A_Validating"/>
    <ns0:sequenceFlow id="flow_30" sourceRef="task_W_Validate application" targetRef="task_O_Accepted" name="W_Validate application → O_Accepted"/>
    <ns0:sequenceFlow id="flow_31" sourceRef="task_W_Validate application" targetRef="task_W_Call incomplete files" name="W_Validate application → W_Call incomplete files"/>
    <ns0:sequenceFlow id="flow_32" sourceRef="task_W_Validate application" targetRef="task_W_Validate application" name="W_Validate application → W_Validate application"/>
    <ns0:sequenceFlow id="flow_33" sourceRef="start_event" targetRef="task_A_Create Application" name="&gt;&gt; → A_Create Application"/>
    <ns0:sequenceFlow id="flow_34" sourceRef="task_W_Call after offers" targetRef="end_event" name="W_Call after offers → &lt;&lt;"/>
    <ns0:sequenceFlow id="flow_35" sourceRef="task_W_Validate application" targetRef="end_event" name="W_Validate application → &lt;&lt;"/>
    <ns0:sequenceFlow id="flow_36" sourceRef="task_W_Call incomplete files" targetRef="end_event" name="W_Call incomplete files → &lt;&lt;"/>
    <ns0:sequenceFlow id="flow_37" sourceRef="task_O_Cancelled" targetRef="end_event" name="O_Cancelled → &lt;&lt;"/>
    <ns0:sequenceFlow id="flow_38" sourceRef="task_W_Complete application" targetRef="end_event" name="W_Complete application → &lt;&lt;"/>
  </ns0:process>
</ns0:definitions>